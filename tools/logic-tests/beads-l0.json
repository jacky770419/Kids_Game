 {
  "eval": "(()=>{const p=document.querySelector('.beads-princess');window.__joy=0;window.__joy2=0;if(!p)return 'no princess';new MutationObserver(()=>{if(p.classList.contains('beads-joy'))window.__joy++;if(p.classList.contains('beads-joy2'))window.__joy2++;}).observe(p,{attributes:true,attributeFilter:['class']});return 'watching'})()"
 },
 {
  "expect": "(()=>{const p=document.querySelector('.beads-princess img');const s=document.getElementById('lgStage').getBoundingClientRect();if(!p||!p.naturalWidth)return false;const r=p.getBoundingClientRect();const hit=[...document.querySelectorAll('.beads-slot,.beads-tray')].some(e=>{const b=e.getBoundingClientRect();return b.left<r.right&&b.right>r.left&&b.top<r.bottom&&b.bottom>r.top});return !hit&&r.left>=s.left&&r.right<=s.right&&r.top>=s.top&&r.bottom<=s.bottom})()",
  "why": "公主有載到圖、在板面裡、沒擋到項鍊和珠寶盒"
 },
 {
  "expect": "(()=>{const f=[...document.querySelectorAll('.beads-src circle')].map(c=>c.getAttribute('fill').toUpperCase()).sort().join();return f==='#4AA8EE,#FF7FB0'})()",
  "why": "第一條是粉＋藍"
 },
